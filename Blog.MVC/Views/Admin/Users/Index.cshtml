@using Blog.Domain.Enums
@using Blog.MVC.ViewModels.Admin;
@using System.Diagnostics
@model AdminUserListViewModel;

@{
    ViewData["Title"] = "Administration user list";
}

<h1>@ViewData["Title"]</h1>

<div class="card mb-4">
    <div class="card-header">
        <strong>User Filters</strong>
    </div>

    <div class="card-body">
        <form method="get" asp-controller="Admin" asp-action="UserIndex" class="row g-3 align-items-end">

            <div class="col-md-4">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" />
            </div>

            <div class="col-md-4">
                <label asp-for="EmailAddress" class="form-label">Email address</label>
                <input asp-for="EmailAddress" class="form-control" />
            </div>

            <div class="col-md-2">
                <label asp-for="HasConfirmedEmailAddress" class="form-label">Email address status</label>
                <select asp-for="HasConfirmedEmailAddress" class="form-select">
                    <option value="">All</option>
                    <option value="true">Has confirmed email address</option>
                    <option value="false">No confirmed email address</option>
                </select>
            </div>

            <div class="col-md-6">
                <label asp-for="SelectedUserRoles" class="form-label">Roles</label>
                <div class="border rounded p-2" style="max-height: 200px; overflow-y: auto;">
                    @foreach (var userRole in Enum.GetValues<UserRoleEnum>().ToList())
                    {
                        var isChecked = Model.SelectedUserRoles.Contains(userRole);

                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="SelectedUserRoles"
                                   value="@userRole"
                                   id="role_@userRole"
                                   @(isChecked ? "checked" : "") />

                            <label class="form-check-label"
                                   for="role_@userRole">
                                @userRole.ToString()
                            </label>
                        </div>
                    }
                    <div class="mb-2">
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                onclick="toggleRoles(true)">
                            Select all
                        </button>

                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                onclick="toggleRoles(false)">
                            Clear all
                        </button>
                    </div>

                    <script>
                        function toggleRoles(selectAll) {
                            document
                                .querySelectorAll('input[name="SelectedUserRoles"]')
                                .forEach(cb => cb.checked = selectAll);
                        }
                    </script>
                </div>
            </div>

            <div class="col-md-6 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Search
                </button>

                <a asp-controller="Admin" asp-action="UserIndex" class="btn btn-outline-secondary">
                    Reset
                </a>
            </div>

        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <strong>Users</strong>
        <span class="text-muted">
            (@Model.Users.Count)
        </span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Roles</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Users.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            No users found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>
                                <strong>@user.Username</strong>
                            </td>

                            <td>
                                @if (string.IsNullOrEmpty(user.EmailAddress))
                                {
                                    <span class="badge bg-warning text-dark">
                                        No email
                                    </span>
                                }
                                else
                                {
                                    @user.EmailAddress
                                }
                            </td>

                            <td>
                                @foreach (var role in user.Roles)
                                {
                                    <span class="badge bg-secondary me-1">
                                        @role.ToString()
                                    </span>
                                }
                            </td>

                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-controller="Admin" 
                                        asp-action="UserDetails"
                                        asp-route-userId="@user.Id"
                                        class="btn btn-outline-primary">
                                        View
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
