@using Blog.Domain.Enums
@using Blog.MVC.ViewModels.Admin;
@model UpdateUserRolesViewModel;

@{
    ViewData["Title"] = $"Update {Model.Username} roles";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-12">
        <form method="post" asp-controller="Admin" asp-action="UpdateUserRoles" asp-route-userId=@Model.Id>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="SelectedUserRoles" class="form-label">Roles</label>
                <div class="border rounded p-2" style="max-height: 200px; overflow-y: auto;">
                    @foreach (var userRole in Enum.GetValues<UserRoleEnum>().ToList())
                    {
                        var isChecked = Model.SelectedUserRoles?.Contains(userRole) == true;

                        <div class="form-check @(Model.AssignedUserRoles.Contains(userRole) ? "fw-bolder" : "")">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="SelectedUserRoles"
                                   value="@userRole"
                                   id="role_@userRole"
                                   @(isChecked ? "checked" : "") />

                            <label class="form-check-label"
                                   for="role_@userRole">
                                @userRole.ToString()
                            </label>
                        </div>
                    }
                    <div class="mb-2">
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                onclick="toggleRoles(true)">
                            Select all
                        </button>

                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                onclick="toggleRoles(false)">
                            Clear all
                        </button>
                    </div>

                    <script>
                        function toggleRoles(selectAll) {
                            document
                                .querySelectorAll('input[name="SelectedUserRoles"]')
                                .forEach(cb => cb.checked = selectAll);
                        }
                    </script>
                </div>
            </div>

            <input type="hidden" asp-for="Id" value="@Model.Id" />
            <input type="hidden" asp-for="Username" value="@Model.Username" />

            @foreach (var role in Model.AssignedUserRoles)
            {
                <input type="hidden" name="AssignedUserRoles" value="@role" />
            }

            <button type="submit" class="btn btn-primary">Update roles</button>
            <a asp-controller="Admin" asp-action="UserDetails" asp-route-userId=@Model.Id class="btn btn-secondary">Back to user</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}