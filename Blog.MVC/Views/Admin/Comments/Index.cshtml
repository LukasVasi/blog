@using Blog.MVC.ViewModels.Admin
@model ReportedCommentsListViewModel

@{
    ViewData["Title"] = "Reported comments";
}

<h1>@ViewData["Title"]</h1>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Comment</th>
                    <th>User</th>
                    <th>Article</th>
                    <th>Created</th>
                    <th>Reports</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Comments.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            No reported comments 🎉
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var comment in Model.Comments)
                    {
                        <tr>
                            <td style="max-width: 300px;">
                                <span title="@comment.PreviewText">
                                    @comment.PreviewText
                                </span>
                            </td>

                            <td>@comment.CommentatorUsername</td>

                            <td>@comment.ArticleTitle</td>

                            <td class="text-muted">
                                @comment.CreatedAt.ToString("yyyy-MM-dd")
                            </td>

                            <td>
                                <span class="badge bg-warning text-dark">
                                    @comment.ReportCount
                                </span>
                            </td>

                            <td>
                                @if (comment.IsHidden)
                                {
                                    <span class="badge bg-secondary">Hidden</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Visible</span>
                                }
                            </td>

                            <td class="text-end">
                                <a asp-action="CommentDetails"
                                   asp-controller="Admin"
                                   asp-route-commentId="@comment.CommentId"
                                   class="btn btn-sm btn-outline-primary">
                                    View
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
