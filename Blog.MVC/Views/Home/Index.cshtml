@using Blog.Application.Articles.Enums
@using Blog.MVC.ViewModels.Home
@using System.Security.Claims
@model HomeIndexViewModel
@{
    ViewData["Title"] = "Home";
}

<div class="bg-light py-5 mb-5 rounded">
    <div class="container text-center">
        <h1 class="display-4 fw-bold mb-3">Welcome to the Blog</h1>
        <p class="lead text-muted mb-4">
            Discover articles or join our community and share your own ideas
        </p>

        <form method="get" asp-action="Search" class="mx-auto" style="max-width: 600px;">
            <div class="input-group input-group-lg shadow-sm">
                <input type="text"
                       name="searchQuery"
                       class="form-control"
                       placeholder="What are you looking for today?"
                       aria-label="Search articles"
                       required>
                <button class="btn btn-primary px-4" type="submit">
                    <i class="bi bi-search"></i> Search
                </button>
            </div>
        </form>
    </div>
</div>

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h3">
            <i class="bi bi-clock-history text-primary"></i>
            Latest Articles
        </h2>
        <a asp-controller="Articles" asp-action="Index" asp-route-sortOrder="@ArticleSortOrder.Latest" class="btn btn-sm btn-outline-primary">
            View All <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    @if (Model.LatestArticles.Any())
    {
        <div class="row row-cols-1 row-cols-lg-2 g-4">
            @foreach (var article in Model.LatestArticles)
            {
                <div class="col">
                    <partial name="_HomeArticleCard" model="article" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">No articles have been published yet.</div>
    }
</section>

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h3">
            <i class="bi bi-star-fill text-warning"></i>
            Top Rated Articles
        </h2>
        <a asp-controller="Articles"
           asp-action="Index"
           asp-route-sortOrder="@ArticleSortOrder.Ranking"
           class="btn btn-sm btn-outline-primary">
            View All <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    @if (Model.TopRatedArticles.Any())
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var article in Model.TopRatedArticles)
            {
                <div class="col">
                    <partial name="_HomeArticleCard" model="article" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">No rated articles yet. Be the first to rate!</div>
    }
</section>

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h3">
            <i class="bi bi-chat-dots-fill text-success"></i>
            Active Discussions
        </h2>
        <a asp-controller="Articles" asp-action="Index" class="btn btn-sm btn-outline-primary">
            View All <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    @if (Model.RecentlyCommentedArticles.Any())
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var article in Model.RecentlyCommentedArticles)
            {
                <div class="col">
                    <partial name="_HomeArticleCard" model="article" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">No comments yet. Start the conversation!</div>
    }
</section>

@if (User.Identity?.IsAuthenticated == true && User.IsInRole("Editor"))
{
    <div class="bg-primary text-white p-4 rounded text-center mb-5">
        <h3 class="mb-3">Ready to share your insights with the Blog community?</h3>
        <a asp-controller="Articles" asp-action="Create" class="btn btn-light btn-lg">
            <i class="bi bi-pencil-square"></i> Create New Article
        </a>
    </div>
}
else if (User.Identity?.IsAuthenticated != true)
{
    <div class="bg-light p-4 rounded text-center mb-5">
        <h3 class="mb-3">Join our community</h3>
        <p class="text-muted mb-3">Sign up to create and rate articles, leave comments, and more</p>
        <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg me-2">
            Sign Up
        </a>
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-lg">
            Sign In
        </a>
    </div>
}