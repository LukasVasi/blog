@using System.Security.Claims
@using Blog.Application.Articles
@using Blog.Application.Articles.Enums
@using Blog.MVC.ViewModels.Articles
@model ArticleIndexViewModel

@{
    string title = "";
    if (Model.IsSearching)
    {
        title = $"Search Results for \"{Model.SearchQuery}\"";
        if (Model.HasAuthor)
        {
            title += $" in articles by {Model.AuthorUsername}";
        }
    }
    else
    {
        title = "Articles";
        if (Model.HasAuthor)
        {
            title += $" by {Model.AuthorUsername}";
        }
    }

    ViewData["Title"] = title;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@ViewData["Title"]</h1>
    @if (User.IsInRole("Editor") && (!Model.HasAuthor || Model.AuthorId.ToString() == User.FindFirstValue(ClaimTypes.NameIdentifier)))
    {
        <a asp-action="Create" class="btn btn-primary">Create New Article</a>
    }
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-controller="Articles" asp-action="Index">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <input type="text"
                               name="search"
                               class="form-control"
                               placeholder="Search articles..."
                               value="@Model.SearchQuery"
                               aria-label="Search query">
                        <button class="btn btn-primary" type="submit">
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>
                </div>

                <div class="col-md-2">
                    <select name="searchType" class="form-select" aria-label="Search field" onchange="this.form.submit()">
                        <option value="@ArticleSearchType.All" selected="@(Model.SearchType == ArticleSearchType.All)">
                            Search In All Fields
                        </option>
                        <option value="@ArticleSearchType.Title" selected="@(Model.SearchType == ArticleSearchType.Title)">
                            Search In Title Only
                        </option>
                        <option value="@ArticleSearchType.Text" selected="@(Model.SearchType == ArticleSearchType.Text)">
                            Search In Content Only
                        </option>
                        <option value="@ArticleSearchType.Author" selected="@(Model.SearchType == ArticleSearchType.Author)">
                            Search In Author Only
                        </option>
                    </select>
                </div>

                <div class="col-md-2">
                    <select name="sortOrder" class="form-select" aria-label="Sort order" onchange="this.form.submit()">
                        <option value="@ArticleSortOrder.Relevance" selected="@(Model.SortOrder == ArticleSortOrder.Relevance)">
                            Most Relevant
                        </option>
                        <option value="@ArticleSortOrder.Latest" selected="@(Model.SortOrder == ArticleSortOrder.Latest)">
                            Latest First
                        </option>
                        <option value="@ArticleSortOrder.Oldest" selected="@(Model.SortOrder == ArticleSortOrder.Oldest)">
                            Oldest First
                        </option>
                        <option value="@ArticleSortOrder.Ranking" selected="@(Model.SortOrder == ArticleSortOrder.Ranking)">
                            Highest Rated
                        </option>
                    </select>
                </div>

                <div class="col-md-2">
                    <select name="pageSize" class="form-select" aria-label="Page size" onchange="this.form.submit()">
                        @foreach (var size in new[] { 5, 10, 20, 50 })
                        {
                            <option value="@size"
                                    selected="@(Model.PageSize == size)">
                                @size per page
                            </option>
                        }
                    </select>
                </div>
            </div>

            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="authorId" value="@Model.AuthorId" />
        </form>

        <div class="d-flex flex-row justify-content-start gap-2">
            @if (Model.HasAuthor)
            {
                <div class="mt-3">
                    <span class="text-muted">
                        Showing articles by @Model.AuthorUsername
                    </span>
                    <a asp-controller="Articles" 
                        asp-action="Index"
                        asp-route-page="1"
                        asp-route-pageSize="@Model.PageSize"
                        asp-route-sortOrder="@Model.SortOrder"
                        asp-route-search="@Model.SearchQuery"
                        asp-route-searchType="@Model.SearchType"
                    class="btn btn-sm btn-outline-secondary ms-2">
                        All Articles
                    </a>
                </div>
            }

            @if (Model.IsSearching)
            {
                <div class="mt-3">
                    <span class="text-muted">
                        Found @Model.TotalCount @(Model.TotalCount == 1 ? "result" : "results")
                    </span>
                    <a asp-controller="Articles" 
                        asp-action="Index"
                        asp-route-page="1"
                        asp-route-pageSize="@Model.PageSize"
                        asp-route-sortOrder="@Model.SortOrder"
                        asp-route-searchType="@Model.SearchType"
                        asp-route-authorId="@Model.AuthorId"
                    class="btn btn-sm btn-outline-secondary ms-2">
                        Clear Search
                    </a>
                </div>
            }
        </div>

    </div>
</div>

@if (!Model.ArticlePreviews.Any())
{
    <div class="alert alert-info">
        @if (Model.IsSearching)
        {
            <p class="mb-0">No articles found matching your search criteria.</p>
        }
        else
        {
            <p class="mb-0">No articles have been published yet.</p>
        }
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-lg-2 g-4">
        @foreach (var article in Model.ArticlePreviews)
        {
            <div class="col">
                <article class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="row align-items-start">
                            <div class="col">
                                <div class="d-flex flex-row align-items-center mb-4">
                                    <h2 class="h5 card-title mb-0 me-auto">
                                        <a asp-controller="Articles"
                                            asp-action="Details"
                                            asp-route-id="@article.Id"
                                            class="text-decoration-none link-dark">
                                            @if (Model.IsSearching && Model.SearchType is ArticleSearchType.All or ArticleSearchType.Title)
                                            {
                                                @Html.Raw(HighlightSearchTerm(article.Title, Model.SearchQuery))
                                            }
                                            else
                                            {
                                                @article.Title
                                            }
                                        </a>
                                    </h2>

                                    @{
                                        var ratingClass = article.Rating > 0
                                        ? "text-success"
                                        : article.Rating < 0
                                        ? "text-danger"
                                        : "text-muted";

                                        var icon = article.Rating > 0
                                        ? "bi-hand-thumbs-up"
                                        : article.Rating < 0
                                        ? "bi-hand-thumbs-down"
                                        : "bi-dash-circle";
                                    }

                                    <span class="@ratingClass ms-2">
                                        <i class="bi @icon"></i>
                                        @article.Rating
                                    </span>

                                    <span class="text-muted ms-2">
                                        <i class="bi bi-chat-left"></i> @article.CommentCount
                                    </span>
                                </div>

                                <div class="d-flex justify-content-between text-muted small">
                                    <span>
                                        By
                                        @if (Model.AuthorId == article.AuthorId)
                                        {
                                            <strong>
                                                @if (Model.IsSearching && Model.SearchType is ArticleSearchType.All or ArticleSearchType.Author)
                                                {
                                                    @Html.Raw(HighlightSearchTerm(article.AuthorUsername, Model.SearchQuery))
                                                }
                                                else
                                                {
                                                    @article.AuthorUsername
                                                }
                                            </strong>
                                        }
                                        else
                                        {
                                            <a asp-action="Index"
                                               asp-route-authorId="@article.AuthorId"
                                               class="text-decoration-none">
                                                @if (Model.IsSearching && Model.SearchType is ArticleSearchType.All or ArticleSearchType.Author)
                                                {
                                                    @Html.Raw(HighlightSearchTerm(article.AuthorUsername, Model.SearchQuery))
                                                }
                                                else
                                                {
                                                    @article.AuthorUsername
                                                }
                                            </a>
                                        }
                                    </span>
                                    <span>@article.CreatedAt.ToString("yyyy-MM-dd")</span>
                                </div>
                            </div>

                            @if (
                                User.Identity?.IsAuthenticated == true &&
                                User.IsInRole("Editor") &&
                                User.FindFirstValue(ClaimTypes.NameIdentifier) == article.AuthorId.ToString()
                            )
                            {
                                <div class="col-auto d-flex flex-column gap-1">
                                    <a asp-controller="Articles"
                                        asp-action="Update"
                                        asp-route-id="@article.Id"
                                        class="btn btn-sm btn-outline-secondary"
                                        title="Edit article">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <form asp-controller="Articles"
                                            asp-action="Delete"
                                            asp-route-id="@article.Id"
                                            method="post"
                                            onsubmit="return confirm('Are you sure you want to delete this article?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                title="Delete article">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}

@if (Model.TotalPages > 1)
{
    <nav aria-label="Article pagination" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link"
                    asp-action="Index"
                    asp-route-page="@(Model.Page - 1)"
                    asp-route-pageSize="@Model.PageSize"
                    asp-route-sortOrder="@Model.SortOrder"
                    asp-route-search="@Model.SearchQuery"
                    asp-route-searchType="@Model.SearchType"
                    asp-route-authorId="@Model.AuthorId">
                    Previous
                </a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link"
                        asp-action="Index"
                        asp-route-page="@i"
                        asp-route-pageSize="@Model.PageSize"
                        asp-route-sortOrder="@Model.SortOrder"
                        asp-route-search="@Model.SearchQuery"
                        asp-route-searchType="@Model.SearchType"
                        asp-route-authorId="@Model.AuthorId">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link"
                    asp-action="Index"
                    asp-route-page="@(Model.Page + 1)"
                    asp-route-pageSize="@Model.PageSize"
                    asp-route-sortOrder="@Model.SortOrder"
                    asp-route-search="@Model.SearchQuery"
                    asp-route-searchType="@Model.SearchType"
                    asp-route-authorId="@Model.AuthorId">
                    Next
                </a>
            </li>
        </ul>
    </nav>
}


@if ((User.Identity?.IsAuthenticated ?? false) && User.IsInRole("Editor"))
{
    <a asp-controller="Articles"
       asp-action="Create"
       class="btn btn-primary btn-lg rounded-circle shadow position-fixed bottom-0 end-0 m-3 m-sm-4 d-flex align-items-center justify-content-center"
       style="width: 56px; height: 56px; z-index: 100;"
       aria-label="Create article">
        <span class="fs-3 lh-1">+</span>
    </a>
}

@functions {
    /// <summary>
    /// Highlights the search term provided in the search query in 
    /// the provided text by wrapping the match in <mark> elements.
    /// The highlighting is case-insensitive.
    /// </summary>
    /// <param name="text">The text to be highlighted.</param>
    /// <param name="searchQuery">The search query.</param>
    /// <returns>The text with matching parts highlighted.</returns>
    private string HighlightSearchTerm(string text, string? searchQuery)
    {
        if (string.IsNullOrWhiteSpace(searchQuery) || string.IsNullOrWhiteSpace(text))
        {
            return System.Web.HttpUtility.HtmlEncode(text);
        }

        var encodedText = System.Web.HttpUtility.HtmlEncode(text);
        var encodedQuery = System.Web.HttpUtility.HtmlEncode(searchQuery);
        
        var pattern = new System.Text.RegularExpressions.Regex(
            System.Text.RegularExpressions.Regex.Escape(encodedQuery), 
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        
        return pattern.Replace(encodedText, match => $"<span class=\"m-0 p-0 rounded-1 bg-warning\">{match.Value}</span>");
    }
}