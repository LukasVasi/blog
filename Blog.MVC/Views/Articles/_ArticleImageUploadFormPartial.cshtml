@using Blog.MVC.ViewModels.Articles
@model ArticleImageUploadFormViewModel

<div class="form-group mb-3">
    <label>Image (optional)</label>

    <input id="imageUpload" 
        type="file" 
        class="form-control" 
        accept="image/*"
        data-upload-url="@Url.Action("UploadArticleImage", "Articles")" />

    <small class="form-text text-muted">
        Maximum file size: 5MB. Supported formats: JPG, PNG, GIF.
    </small>

    <div id="uploadStatus" class="mt-2"></div>

    <div id="imagePreviewContainer"
         class="mt-3"
         style="@(Model.CurrentImageUrl != null ? "" : "display:none;")">

        <div class="card" style="max-width: 400px;">
            <div class="ratio ratio-21x9 rounded overflow-hidden bg-light card-img-top">
                <img id="imagePreview"
                     class="img-fluid"
                     style="object-fit: contain;"
                     src="@Model.CurrentImageUrl"
                     alt="Article image preview" />
            </div>

            <div class="card-body text-center">
                <span class="text-muted small d-block mb-2">Current image</span>
                <button type="button" id="removeImageBtn" class="btn btn-sm btn-danger">
                    Remove Image
                </button>
            </div>
        </div>
    </div>

    <input type="hidden" asp-for="CurrentImageUrl" id="originalImageUrlField" />
    <input type="hidden" asp-for="ImageId" id="imageIdField" />
    <span asp-validation-for="ImageId" class="text-danger"></span>
</div>
