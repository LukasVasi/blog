@using Blog.Domain.Entities.Article
@using Blog.MVC.ViewModels.Articles;
@using System.Security.Claims
@model ArticleDetailsViewModel;

@{
    ViewData["Title"] = Model.Title;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-7">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="ratio ratio-21x9 rounded overflow-hidden bg-light mb-4">
                    <img 
                        src="@Model.ImageUrl"
                        alt="@Model.Title"
                        class="position-absolute top-50 start-50 translate-middle img-fluid"
                        style="max-height: 100%; max-width: 100%; object-fit: contain;" 
                        />
                </div>
            }

            <div class="text-muted small mb-2">
                @Model.CreatedAt.ToString()
            </div>

            <h1 class="fw-bold mb-2">
                @Model.Title
            </h1>

            <div class="d-flex flex-row justify-content-between">
                <div class="text-secondary mb-4">
                    By
                    <a asp-controller="Articles"
                       asp-action="Index"
                       asp-route-authorId="@Model.AuthorId"
                       class="text-decoration-none">
                        @Model.AuthorUsername
                    </a>
                </div>

                <span>
                    @{
                        var ratingClass = Model.Rating > 0
                        ? "text-success"
                        : Model.Rating < 0
                        ? "text-danger"
                        : "text-muted";

                        var icon = Model.Rating > 0
                        ? "bi-hand-thumbs-up"
                        : Model.Rating < 0
                        ? "bi-hand-thumbs-down"
                        : "bi-dash-circle";
                    }

                    <span class="@ratingClass ms-2">
                        <i class="bi @icon"></i>
                        @Model.Rating
                    </span>

                    <span class="text-muted ms-2">
                        <i class="bi bi-chat-left"></i> @Model.Comments.Count
                    </span>
                </span>
            </div>

            @if (
                User.Identity?.IsAuthenticated == true &&
                User.IsInRole("Editor") &&
                User.FindFirstValue(ClaimTypes.NameIdentifier) == Model.AuthorId.ToString()
            )
            {
                <div role="group" aria-label="Article actions">
                    <a asp-controller="Articles"
                       asp-action="Update"
                       asp-route-id="@Model.Id"
                       class="btn btn-secondary">
                        <i class="bi bi-pencil"></i>
                        Edit
                    </a>

                    <form asp-controller="Articles"
                          asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="d-inline"
                          onsubmit="return confirm('Are you sure you want to delete this article?');">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-danger">
                            <i class="bi bi-trash"></i>
                            Delete
                        </button>
                    </form>
                </div>
            }

            <div class="fs-5 lh-lg" style="white-space: pre-line;">@Model.Text</div>

            @if (
                User.Identity?.IsAuthenticated == true &&
                User.IsInRole("Critic") &&
                User.FindFirstValue(ClaimTypes.NameIdentifier) != Model.AuthorId.ToString()
            )
            {
                <div class="card mt-4">
                    <div class="card-body">
                        <h5 class="card-title">Rate this article</h5>

                        @if (Model.AuthenticatedUserRating != null)
                        {
                            <div class="alert alert-info">
                                You rated this article:
                                <strong>
                                    @(Model.AuthenticatedUserRating == ArticleRatingValue.Positive 
                                    ? Html.Raw("<i class=\"bi bi-hand-thumbs-up\"></i> Positive")
                                    : Html.Raw("<i class=\"bi bi-hand-thumbs-down\"></i> Negative"))
                                </strong>
                            </div>
                        }

                        <form method="post" asp-controller="Articles" asp-action="RateArticle" asp-route-id="@Model.Id" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="rating" value="@((int)ArticleRatingValue.Positive)" />
                            <button type="submit" class="btn @(Model.AuthenticatedUserRating == ArticleRatingValue.Positive 
                                ? "btn-success" : "btn-outline-success")">
                                <i class="bi bi-hand-thumbs-up"></i> Positive
                            </button>
                        </form>

                        <form method="post" asp-controller="Articles" asp-action="RateArticle" asp-route-id="@Model.Id" class="d-inline ms-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="rating" value="@((int)ArticleRatingValue.Negative)" />
                            <button type="submit" class="btn @(Model.AuthenticatedUserRating == ArticleRatingValue.Negative ? "btn-danger" : "btn-outline-danger")">
                                <i class="bi bi-hand-thumbs-down"></i> Negative
                            </button>
                        </form>

                        @if (Model.AuthenticatedUserRating != null)
                        {
                            <form method="post" asp-controller="Articles" asp-action="DeleteArticleRating" asp-route-id="@Model.Id" class="d-inline ms-2">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-secondary">
                                    Remove Rating
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }

            <section class="mt-5">
                <h4 class="mb-4">Comments</h4>

                @if (
                    User.Identity?.IsAuthenticated == true &&
                    User.IsInRole("Commentator")
                )
                {
                    <form asp-controller="Articles"
                          asp-action="CreateComment"
                          asp-route-articleId="@Model.Id"
                          method="post"
                          class="mb-4">

                        @Html.AntiForgeryToken()

                        <div class="mb-2">
                            <textarea name="text"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Add a comment..."
                                  required></textarea>
                        </div>

                        <div class="text-end">
                            <button type="submit" class="btn btn-sm btn-primary">
                                Comment
                            </button>
                        </div>
                    </form>
                }

                @foreach (var comment in Model.Comments.OrderBy(comment => comment.Comment.CreatedAt))
                {
                    <partial name="_ArticleCommentPartial" model="comment" />
                }
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/comments.js"></script>
}