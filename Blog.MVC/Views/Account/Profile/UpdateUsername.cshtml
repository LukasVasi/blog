@using Blog.MVC.ViewModels.Account.Profile;
@model UpdateUsernameViewModel;

@{
    ViewData["Title"] = "Update Username";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-12">
        <form method="post" asp-controller="Account" asp-action="UpdateUsername">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="CurrentUsername">Current username</label>
                <input asp-for="CurrentUsername" class="form-control" disabled />
            </div>
            <div class="form-group mb-3">
                <label asp-for="NewUsername">New username</label>
                <input asp-for="NewUsername" class="form-control" />
                <span asp-validation-for="NewUsername" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Update</button>
            <a asp-controller="Account" asp-action="Profile" class="btn btn-secondary">Back</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}