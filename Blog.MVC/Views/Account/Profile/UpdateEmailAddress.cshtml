@using Blog.MVC.ViewModels.Account.Profile;
@model UpdateEmailAddressViewModel;

@{
    ViewData["Title"] = "Update Email Address";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-12">
        <form method="post" asp-controller="Account" asp-action="UpdateEmailAddress">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="CurrentEmailAddress">Current email eddress</label>
                <input asp-for="CurrentEmailAddress" class="form-control" disabled />
            </div>
            <div class="form-group mb-3">
                <label asp-for="NewEmailAddress">New email address</label>
                <input asp-for="NewEmailAddress" class="form-control" />
                <span asp-validation-for="NewEmailAddress" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Update</button>
            <a asp-controller="Account" asp-action="Profile" class="btn btn-secondary">Back</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}